{
  "_comment": "Add these hooks to .claude/settings.json. Merge with existing hooks, do not replace.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/enforcer/dist/index.js intent-gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/enforcer/dist/index.js phase-guard"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/enforcer/dist/index.js agent-dispatcher"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/enforcer/dist/index.js agent-tracker"
          }
        ]
      }
    ]
  }
}
