{
  "_comment": "Add these hooks to .claude/settings.json. Merge with existing hooks, do not replace.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/enforcer/dist/index.js intent-gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/enforcer/dist/index.js phase-guard"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/enforcer/dist/index.js agent-dispatcher"
          }
        ]
      },
      {
        "matcher": "Bash|Agent|Write|Edit|Glob|Grep|NotebookEdit|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/enforcer/dist/index.js read-gate-pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/enforcer/dist/index.js agent-tracker"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/enforcer/dist/index.js phase-advance"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/enforcer/dist/index.js read-gate-post"
          }
        ]
      }
    ]
  }
}
